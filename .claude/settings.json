{
  "permissions": {
    "allow": [
      "PowerShell(Import-Module Pester:*)",
      "PowerShell(Invoke-Pester:*)",
      "PowerShell(Import-Module:*)",
      "PowerShell(Test-Json:*)",
      "PowerShell(Invoke-ScriptAnalyzer:*)",
      "Bash(pwsh -NoProfile -File ./scripts/Tagger.ps1 settings show)",
      "Bash(pwsh -NoProfile -File ./scripts/Tagger.ps1 session list)"
    ],
    "deny": [
      "Read(./.env)",
      "Grep(./.env)",
      "Bash(cat .env)",
      "Bash(cat ./.env)",
      "Bash(head .env)",
      "Bash(head ./.env)",
      "Bash(tail .env)",
      "Bash(tail ./.env)",
      "Bash(more .env)",
      "Bash(less .env)",
      "PowerShell(cat .env)",
      "PowerShell(cat ./.env)",
      "PowerShell(Get-Content .env)",
      "PowerShell(Get-Content ./.env)",
      "PowerShell(type .env)"
    ]
  }
}
